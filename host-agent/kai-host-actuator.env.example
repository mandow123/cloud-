# Comma-separated immutable OCI references approved by KAI Cloud operations.
# Never use tags here. Example:
# KAI_HOSTING_APPROVED_IMAGES=ghcr.io/mandow123/kai-cloud-gpu-workload@sha256:<64 lowercase hex characters>
KAI_HOSTING_APPROVED_IMAGES=

# Exact physical GPU UUID assigned to this Agent. Copy from nvidia-smi; never use an index.
KAI_HOST_GPU_UUID=
