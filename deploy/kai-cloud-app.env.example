# Load together with kai-cloud-release.env when rendering Compose.
# Store the real file at /etc/kai-cloud/kai-cloud-app.env with mode 0640.
KAI_PUBLIC_ORIGIN=https://cloud.kai.com
KAI_CURSOR_SECRET=replace-with-at-least-32-cryptographically-random-characters
KAI_TRUST_PROXY=1
KAI_REQUIRE_HTTPS_WRITES=1
# Keep HSTS disabled for the loopback canary. Set to 1 only after the real
# HTTPS domain, certificate renewal, redirects, and application flows pass.
KAI_ENABLE_HSTS=0
KAI_APP_PORT=3051

# KAI Admin: 独立账号密码。哈希格式为 pbkdf2-sha256:iterations:salt:hash。
KAI_ADMIN_USERNAME=kai-root
KAI_ADMIN_PASSWORD_HASH=
KAI_ADMIN_DISPLAY_NAME=KAI Cloud Root
KAI_ADMIN_APPROVER_USERNAME=kai-finance-approver
KAI_ADMIN_APPROVER_PASSWORD_HASH=
KAI_ADMIN_APPROVER_DISPLAY_NAME=KAI Cloud Finance Approver

# 普通用户统一登录。Redirect URI 必须在 account.kai.com 控制台精确登记为：
# https://cloud.kai.com/api/auth/kai/callback
KAI_ACCOUNT_OIDC_CLIENT_ID=
KAI_ACCOUNT_OIDC_TRANSACTION_SECRET=replace-with-at-least-32-cryptographically-random-characters
KAI_HOSTING_V2=0
KAI_HOSTING_APPROVED_IMAGES=
KAI_HOSTING_TERMS_VERSION=KAI_HOSTING_TERMS_2026_08

# 生产必须保持关闭；代码还会额外检查 NODE_ENV 与 localhost。
KAI_ADMIN_LOCAL_AUTH=0

# Alipay LIVE remains unavailable until all production merchant values exist.
KAI_ALIPAY_ENABLED=0
KAI_ALIPAY_APP_ID=
KAI_ALIPAY_PRIVATE_KEY=
KAI_ALIPAY_PRIVATE_KEY_TYPE=PKCS8
KAI_ALIPAY_PUBLIC_KEY=
KAI_ALIPAY_SELLER_ID=
KAI_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
KAI_SUPPLY_OPS_TOKEN=
KAI_SSH_PROVISIONER_URL=
KAI_SSH_PROVISIONER_TOKEN=
