# Load together with kai-cloud-release.env when rendering Compose.
# Store the real file at /etc/kai-cloud/kai-cloud-app.env with mode 0640.
KAI_PUBLIC_ORIGIN=https://cloud.kai.com
KAI_CURSOR_SECRET=replace-with-at-least-32-cryptographically-random-characters
KAI_TRUST_PROXY=1
KAI_REQUIRE_HTTPS_WRITES=1
# Keep HSTS disabled for the loopback canary. Set to 1 only after the real
# HTTPS domain, certificate renewal, redirects, and application flows pass.
KAI_ENABLE_HSTS=0
KAI_APP_PORT=3051

# KAI Admin: 独立账号密码。哈希格式为 pbkdf2-sha256:iterations:salt:hash。
KAI_ADMIN_USERNAME=kai-root
KAI_ADMIN_PASSWORD_HASH=
KAI_ADMIN_DISPLAY_NAME=KAI Cloud Root
KAI_ADMIN_APPROVER_USERNAME=kai-finance-approver
KAI_ADMIN_APPROVER_PASSWORD_HASH=
KAI_ADMIN_APPROVER_DISPLAY_NAME=KAI Cloud Finance Approver
KAI_ADMIN_FULFILLMENT_USERNAME=kai-fulfillment
KAI_ADMIN_FULFILLMENT_PASSWORD_HASH=
KAI_ADMIN_FULFILLMENT_DISPLAY_NAME=KAI Cloud Fulfillment Operator

# 普通用户统一登录。Redirect URI 必须在账户中心精确登记为：
# https://cloud.kai.com/api/auth/kai/callback
# 旧账户中心保持 Issuer 留空；新账户中心填写 https://auth.kai.com/api/auth，
# 使用服务端 Web 应用签发的 Client ID 与 Client Secret。
KAI_ACCOUNT_OIDC_CLIENT_ID=
KAI_ACCOUNT_OIDC_CLIENT_SECRET=
KAI_ACCOUNT_OIDC_ISSUER=
KAI_ACCOUNT_OIDC_SCOPES=
KAI_ACCOUNT_OIDC_TRANSACTION_SECRET=replace-with-at-least-32-cryptographically-random-characters
# 目录询价人工 SSH 交付：开启后买家提交公钥，管理员人工配置；不启用自动交付。
KAI_MANUAL_DELIVERY_INTAKE=0
# 人工交付申诉 sidecar。默认关闭；仅在迁移、权限、跨组织隔离与回退演练通过后开启。
KAI_MANUAL_APPEALS_V1=0
# 人工算力商业订单闭环。默认关闭；真实出款始终关闭。
KAI_MANUAL_ORDER_FLOW_V1=0
# 新购买目录：供应商套餐公开浏览、登录后人工询价；不启用自动成交或支付。
KAI_BUY_CATALOG_V2=0
# 统一账户控制台视觉底座。默认关闭；开启只改变账户页面布局，不改变业务权限。
KAI_ACCOUNT_CONSOLE_V2=0
KAI_HOSTING_V2=0
KAI_HOSTING_V2_SETUP=0
KAI_AGENT_TELEMETRY_V1=0
KAI_HOSTING_DEVICE_RETIREMENT=0
KAI_HOSTING_APPROVED_IMAGES=
KAI_HOSTING_TERMS_VERSION=KAI_HOSTING_TERMS_2026_08

# 实体 GPU 云托管封闭 MVP。默认关闭；只有受邀企业、真实可售商品、已验收机房、
# 供应商直售合同、双人审批和卡时结算证据全部就绪后才能开启。
KAI_MANAGED_GPU_MVP=0
# 逗号分隔的受邀企业组织 ID；KAI_MANAGED_GPU_MVP=1 时必须非空且不得重复。
KAI_MANAGED_GPU_INVITED_ORGANIZATIONS=
# 移动 BFF 读取裁剪后的 GPU 资产摘要时使用的服务间凭证；必须使用独立随机密钥，
# 不得复用管理员、支付或 Host Agent 凭证。
KAI_MOBILE_CLOUD_SERVICE_TOKEN=
KAI_MANAGED_GPU_MOBILE_ENABLED=0

# 02672 DGX Spark 活动总开关。默认关闭；开启但未完整核验时仅允许登记兴趣。
KAI_DGX_SPARK_CAMPAIGN_ENABLED=0
KAI_DGX_SPARK_CAMPAIGN_STATUS=PENDING
KAI_DGX_SPARK_SUPPLIER_REVIEW_STATUS=PENDING
# VERIFIED 必须同时填写以下真实、已审核值；本活动配额固定为 200 台，否则服务端自动降级为 PENDING。
KAI_DGX_SPARK_TOTAL_UNITS=
KAI_DGX_SPARK_DISCOUNT_PERCENT=
KAI_DGX_SPARK_COUNTDOWN_SECONDS=
KAI_DGX_SPARK_ESTIMATED_SHIPPING_MONTHS=
KAI_DGX_SPARK_PRICE_CARD_HOURS_MICROS=
KAI_DGX_SPARK_PURCHASE_PATH=

# 生产必须保持关闭；代码还会额外检查 NODE_ENV 与 localhost。
KAI_ADMIN_LOCAL_AUTH=0

# Alipay LIVE remains unavailable until all production merchant values exist.
KAI_ALIPAY_ENABLED=0
KAI_ALIPAY_APP_ID=
KAI_ALIPAY_PRIVATE_KEY=
KAI_ALIPAY_PRIVATE_KEY_TYPE=PKCS8
KAI_ALIPAY_PUBLIC_KEY=
KAI_ALIPAY_SELLER_ID=
KAI_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Qixiang Pay only recharges KAI standard card-hours. Keep disabled until the
# database migration, signed callback and active-query controls pass production
# tests. Record an approved credential version or normal rotation timestamp.
KAI_QIXIANG_PAY_ENABLED=0
KAI_QIXIANG_PAY_RECONCILIATION_ENABLED=0
KAI_QIXIANG_PAY_PID=
KAI_QIXIANG_PAY_KEY=
KAI_QIXIANG_PAY_APPROVAL_REFERENCE=
KAI_QIXIANG_PAY_CREDENTIAL_ROTATED_AT=
KAI_QIXIANG_PAY_CREDENTIAL_VERSION=
KAI_QIXIANG_PAY_LEGACY_QUERY_RISK_ACCEPTED=0
KAI_QIXIANG_PAY_LEGACY_QUERY_RISK_REFERENCE=
KAI_QIXIANG_PAY_QUERY_CREDENTIAL_ID=
KAI_QIXIANG_PAY_QUERY_CREDENTIAL_ROTATED_AT=
KAI_QIXIANG_PAY_QUERY_CREDENTIAL_VERSION=
KAI_QIXIANG_PAY_PILOT_ORGANIZATIONS=
KAI_QIXIANG_PAY_PILOT_CHANNEL=
KAI_QIXIANG_PAY_CHANNELS=
KAI_QIXIANG_PAY_GATEWAY=https://api.payqixiang.cn/mapi.php
KAI_QIXIANG_PAY_QUERY_ENDPOINT=https://api.payqixiang.cn/api.php
KAI_PAYMENT_RECONCILIATION_TOKEN=
KAI_SUPPLY_OPS_TOKEN=
KAI_SSH_PROVISIONER_URL=
KAI_SSH_PROVISIONER_TOKEN=
