[Unit]
Description=KAI Cloud consistent SQLite and market snapshot backup
After=docker.service
Requires=docker.service
OnFailure=kai-cloud-ops-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/kai-cloud/kai-cloud-release.env
ExecStart=/usr/bin/flock --nonblock /run/lock/kai-cloud-backup.lock /usr/bin/timeout --signal=TERM --kill-after=15s 300s /bin/sh /usr/local/lib/kai-cloud/kai-cloud-backup-run.sh
TimeoutStartSec=330
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
